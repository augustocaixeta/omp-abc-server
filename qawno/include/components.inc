/**
 * # Functions
 */

/**
 * The name San Andreas gives a component type, including the two a modshop
 * menu lists alongside the real ones without them being components.
 *
 * @param      type  A `COMPONENT_TYPE_*` value, `COMPONENT_TYPE_VENTS` through
 *                   `COMPONENT_TYPE_PAINT_JOBS`.
 * @param      name  Buffer the name is written into.
 * @param      size  Size of that buffer.
 *
 * @date       12:46 30/08/2026
 * @author     augustocaixeta
 *
 * @return     - `true` a name was written into `name`
 *             - `false` `name` is left empty, when:
 *                 + `type` is below 0
 *                 + `type` is `MAX_COMPONENT_TYPE_NAMES` or above
 */
forward bool:GetVehicleComponentTypeName(type, name[], size = sizeof (name));

/**
 * Which of the sixteen types a component is fitted as. This is the library's
 * own `COMPONENT_TYPE_*`, not the `CARMODTYPE` that open.mp's native
 * `GetVehicleComponentType` hands back for the same component.
 *
 * @param      componentid  Component to read, 1000 to 1193.
 *
 * @date       12:46 30/08/2026
 * @author     augustocaixeta
 *
 * @return     - `COMPONENT_TYPE_*` the type it is fitted as
 *             - `COMPONENT_TYPE_NONE` when:
 *                 + `componentid` is outside 1000 to 1193
 *                 + the component is the second half of a pair, fitted through
 *                   its primary and never listed on its own
 */
forward GetVehicleComponentTypeID(componentid);

/**
 * What the shop charges for a component. A pair is priced once, on the half a
 * menu offers, so adding both halves together would charge twice.
 *
 * @param      componentid  Component to read, 1000 to 1193.
 *
 * @date       12:46 30/08/2026
 * @author     augustocaixeta
 *
 * @return     - the price in dollars
 *             - `0` when:
 *                 + `componentid` is outside 1000 to 1193
 *                 + the component is the second half of a pair
 */
forward GetVehicleComponentCost(componentid);

/**
 * The other half of a two piece component. Sideskirts and vents come in left
 * and right, and fitting one without the other leaves a hole down that side of
 * the car, so both ids go on together.
 *
 * @param      componentid  Component to read, 1000 to 1193.
 *
 * @date       12:46 30/08/2026
 * @author     augustocaixeta
 *
 * @return     - the component id to fit alongside this one
 *             - `INVALID_VEHICLE_COMPONENT_ID` when:
 *                 + `componentid` is outside 1000 to 1193
 *                 + the component is fitted on its own
 */
forward GetVehicleComponentPair(componentid);

/**
 * Who a component is sold to. Either one of the `COMPONENT_AVAILABILITY_*`
 * values or, for a part drawn for one car only, that car's model id. The two
 * cannot be confused because model ids start at 400.
 *
 * This says which shop stocks the part, not which cars will take it. That
 * second question is `CanVehicleModelHaveComponent`.
 *
 * @param      componentid  Component to read, 1000 to 1193.
 *
 * @date       12:46 30/08/2026
 * @author     augustocaixeta
 *
 * @return     - `COMPONENT_AVAILABILITY_MOST` most cars, planes and helicopters
 *             - `COMPONENT_AVAILABILITY_TRANSFENDER` certain Transfender cars
 *             - a vehicle model id, 400 to 611, for a part exclusive to that car
 *             - `COMPONENT_AVAILABILITY_NONE` when:
 *                 + `componentid` is outside 1000 to 1193
 *                 + the component is the second half of a pair
 */
forward GetVehicleComponentAvailability(componentid);

/**
 * The one car a component was drawn for, when it was drawn for one.
 *
 * @param      componentid  Component to read, 1000 to 1193.
 *
 * @date       12:46 30/08/2026
 * @author     augustocaixeta
 *
 * @return     - a vehicle model id, 400 to 611
 *             - `INVALID_VEHICLE_MODEL_ID` when:
 *                 + `componentid` is outside 1000 to 1193
 *                 + the part is sold for most vehicles or across Transfender
 *                   rather than for one car
 */
forward GetVehicleComponentExclusiveModel(componentid);

/**
 * The name of a component, as the shop lists it. The second half of a pair
 * carries no name of its own, so run the id through
 * `GetVehicleComponentPrimary`
 * first when it may have come from `GetVehicleComponentInSlot`.
 *
 * @param      componentid  Component to read, 1000 to 1193.
 * @param      name         Buffer the name is written into.
 * @param      size         Size of that buffer.
 *
 * @date       12:46 30/08/2026
 * @author     augustocaixeta
 *
 * @return     - `true` a name was written into `name`
 *             - `false` `name` is left empty, when:
 *                 + `componentid` is outside 1000 to 1193
 */
forward bool:GetVehicleComponentName(componentid, name[], size = sizeof (name));

/**
 * Whether a vehicle model will take a component. This is what the game itself
 * accepts, which is wider than what the shops sell: nitro, wheels and
 * hydraulics go onto aircraft and boats that no modshop will let you drive in.
 *
 * @param      modelid      Vehicle model, 400 to 611.
 * @param      componentid  Component, 1000 to 1193.
 *
 * @date       12:46 30/08/2026
 * @author     augustocaixeta
 *
 * @return     - `true` the model takes that component
 *             - `false` when:
 *                 + `modelid` is outside 400 to 611
 *                 + `componentid` is outside 1000 to 1193
 *                 + the component does not belong on that model
 */
forward bool:CanVehicleModelHaveComponent(modelid, componentid);

/**
 * The component a shop lists, for any component the game reports.
 * `GetVehicleComponentInSlot` can hand back either half of a pair, and the
 * second half has no type, name or price of its own.
 *
 * Every component that is fitted on its own is its own primary, so any id is
 * safe to run through this.
 *
 * @param      componentid  Component to read, 1000 to 1193.
 *
 * @date       12:46 30/08/2026
 * @author     augustocaixeta
 *
 * @return     - the component id a menu would offer for it
 *             - `INVALID_VEHICLE_COMPONENT_ID` when:
 *                 + `componentid` is outside 1000 to 1193
 */
forward GetVehicleComponentPrimary(componentid);

/**
 * # External
 */

stock bool:GetVehicleComponentTypeName(type, name[], size = sizeof (name)) {
    if (!(0 <= type < MAX_COMPONENT_TYPE_NAMES)) {
        return false;
    }

    strunpack(name, gComponentTypeName[type], size);

    return true;
}

stock GetVehicleComponentTypeID(componentid) {
    if (!IS_VALID_VEHICLE_COMPONENT(componentid)) {
        return COMPONENT_TYPE_NONE;
    }

    return gComponentData[componentid - MIN_VEHICLE_COMPONENT_ID][E_COMPONENT_TYPE];
}

stock GetVehicleComponentCost(componentid) {
    if (!IS_VALID_VEHICLE_COMPONENT(componentid)) {
        return 0;
    }

    return gComponentData[componentid - MIN_VEHICLE_COMPONENT_ID][E_COMPONENT_COST];
}

stock GetVehicleComponentPair(componentid) {
    if (!IS_VALID_VEHICLE_COMPONENT(componentid)) {
        return INVALID_VEHICLE_COMPONENT_ID;
    }

    return gComponentData[componentid - MIN_VEHICLE_COMPONENT_ID][E_COMPONENT_PAIR];
}

stock GetVehicleComponentAvailability(componentid) {
    if (!IS_VALID_VEHICLE_COMPONENT(componentid)) {
        return COMPONENT_AVAILABILITY_NONE;
    }

    return gComponentData[componentid - MIN_VEHICLE_COMPONENT_ID][E_COMPONENT_AVAILABILITY];
}

stock GetVehicleComponentExclusiveModel(componentid) {
    new const
        availability = GetVehicleComponentAvailability(componentid)
    ;

    if (!IS_VALID_VEHICLE_MODEL(availability)) {
        return INVALID_VEHICLE_MODEL_ID;
    }

    return availability;
}

stock bool:GetVehicleComponentName(componentid, name[], size = sizeof (name)) {
    if (!IS_VALID_VEHICLE_COMPONENT(componentid)) {
        return false;
    }

    strunpack(name, gComponentData[componentid - MIN_VEHICLE_COMPONENT_ID][E_COMPONENT_NAME], size);

    return true;
}

stock bool:CanVehicleModelHaveComponent(modelid, componentid) {
    if (!IS_VALID_VEHICLE_MODEL(modelid)) {
        return false;
    }

    if (!IS_VALID_VEHICLE_COMPONENT(componentid)) {
        return false;
    }

    new const
        index = componentid - MIN_VEHICLE_COMPONENT_ID,
        cell = (modelid - MIN_VEHICLE_MODEL_ID) * VEHICLE_COMPONENT_CELLS + (index >>> 5)
    ;

    return bool:((gVehicleComponents[cell] >>> (index & 0b00011111)) & 1);
}

stock GetVehicleComponentPrimary(componentid) {
    if (!IS_VALID_VEHICLE_COMPONENT(componentid)) {
        return INVALID_VEHICLE_COMPONENT_ID;
    }

    return gComponentPrimary[componentid - MIN_VEHICLE_COMPONENT_ID];
}